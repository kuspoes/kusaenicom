{{#
Cara pakai:

{{ comp.relasi_buku({
        keyword: "keywords dari tags"
				abai: title
    })
}}

Jika opsi 'abai: title' ditulis maka pencarian akan mengabaikan
pencarian dengan judul artikel. Ini berguna jika tidak ingin
menampilkan pencarian atas artikel yang saat ini tampil
(dibuka).
#}}

<div class="bukukuku">
    <h5>buku lain yang mungkin kamu suka</h5>


    <div class="relasi_bukuku">
        {{ set bukuku = search.pages(`${ keyword }
				title!='${abai}'`, `date=desc`, 6)}}
        {{ if bukuku.length>0 }}
        {{ for buku of bukuku }}
        <a class="bukuku" href="{{ buku.url }}">
            <div class="relasi_bukuku_cover">
                <img src="{{ buku.coverImg }}" alt="{{ buku.title }}"  loading="lazy" image-size>
            </div>
        </a>
        {{ /for }}
        {{ /if }}
    </div>
</div>
