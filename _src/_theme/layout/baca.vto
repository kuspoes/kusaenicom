{{ include 'bagian/header.vto'}}
	<div class="page">
		<div class="meta">
            <p class="date">
                {{ if date }}
                <time datetime="{{ date }}"> {{ date |> date("id") }}</time>
                <span class="waktu_baca"> — {{ readingInfo.minutes }} menit membaca</span>
                {{ /if }}
            </p>
            <h1>{{ it.title }}</h1>
            {{ if it.ringkasan }}
                <p class="subtitle">{{ it.ringkasan |> md(true) }}</p>
            {{ /if }}
            <div class="postag">
            {{ if it.tags }}
            {{ for tag of it.tags }}
                {{ set page = search.page(`type=tag tag="${tag}"`) }}
                {{ if page }}
                   <a data-pagefind-filter="filter" class="badge" href="{{ page.url }}">#{{ tag }}</a>
                {{ /if }}
            {{ /for }}
            {{ /if }}
        </div>
        </div>
        <div class="content">
        <div class="selayang">
			<div class="selayang__cover">
            <img fetchpriority="high" class="lepas layang" src="{{ metadata.imgdia }}{{ coverImg }}" alt="{{ title }}" image-size>
			</div>
			<div class="selayang__meta">
				<dl>
               <dt>Penulis</dt>
               <dd>{{ penulis }}</dd>
               <dt>Bahasa</dt>
               <dd>{{ bahasa }}</dd>
               <dt>Format</dt>
               <dd>{{ format }}</dd>
               <dt>ISBN</dt>
               <dd>{{ isbn }}∷ {{ tahun }}</dd>
               <dt><a href="/baca/rating">Rating</a></dt>
               <dd>{{ comp.bintang({ bintang: rating }) }} </dd>
               <dt>Beli dimana?</dt>
               <dd><a href="{{ beli }}" target="_blank">{{ dimana }}</a></dd>
            </dl>
			</div>
</div>
        {{  if content }}
            {{ if it.tocx }} {{ if toc.length }}
        <nav class="toc">
            <h4>Daftar Isi</h4>
            <ol>
                {{ for item of toc }}
                <li>
                    <a href="#{{ item.slug }}">{{ item.text }}</a>
                    {{ if item.children.length }}
                    <ul>
                        {{ for child of item.children }}
                        <li>
                            <a href="#{{ child.slug }}">{{ child.text }}</a>
                        </li>
                        {{ /for }}
                    </ul>
                    {{ /if }}
                </li>
                {{ /for }}
            </ol>
        </nav>
        {{ /if }}
        {{ /if }}
            {{ content }}
        {{ /if }}
        {{ if it.footnotes.length }}
        <aside role="note" class="footnotes">
        <h4>Footnotes:</h4>
            {{ for note of footnotes }}
                <div class="notes">
                    <div class="note-id"><a href="#{{ note.refId }}" id="{{ note.id }}">{{ note.label }}</a></div> {{  note.content}}
                </div>
            {{ /for }}
        </aside>
        {{ /if }}
        <hr />
        {{ if comment }}
            <div id="dropcomments-container"></div>
        {{ /if }}
                {{ if it.comments?.src }}
                <div class="comments-section">
                  <header class="comments-header">
                    <h4>{{ metadata.comments.title }}</h4>
                    <p>{{ metadata.comments.description.replace(":src:", it.comments.real) }}</p>
                  </header>
                  <mastodon-comments
                    src="{{ it.comments.src }}"
                    cache="{{ it.comments.cache ?? 60 }}"
                    class="comments"
                  >
                    {{ metadata.comments.empty }}
                  </mastodon-comments>
                </div>
                {{ /if }}
        </div>
	</div>
{{ include 'bagian/footer.vto' }}
